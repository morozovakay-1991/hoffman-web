# Адрес hoffman-backend (Laravel). Используется только на сервере Next.js (BFF-прокси).
HOFFMAN_API_URL=http://127.0.0.1:8000

# Публичный адрес сайта: из него строятся redirect_uri для Apple / Google.
# Для Sign in with Apple обязателен HTTPS.
APP_URL=http://localhost:3000

# Вход через Google (OAuth client типа «Web application»).
# Redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Вход через Apple: Services ID (не bundle id приложения).
# Return URL: ${APP_URL}/api/auth/apple/callback
APPLE_SERVICES_ID=
